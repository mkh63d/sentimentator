# RabbitMQ Configuration
RABBITMQ_URL=amqp://sentimentator_event_bus:rabbitmq_secure_pass@localhost:5672/
RABBITMQ_VHOST=/
RABBITMQ_USER=sentimentator_event_bus
RABBITMQ_PASSWORD=rabbitmq_secure_passa

# Service Configuration
SERVICE_NAME=sentiment-analyzer-placeholder
LOG_LEVEL=info

# Queue Names
TRANSCRIPT_QUEUE=video.transcript
# ANALYSIS_QUEUE=video.analysis
ANALYSIS_QUEUE=video.analysis
ANALYSIS_EXCHANGE=sentimentator.topic
ANALYSIS_ROUTING_KEY=video.analysis.completed
