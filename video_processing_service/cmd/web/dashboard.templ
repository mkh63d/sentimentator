package web

import (
	"fmt"
	"github.com/Oskarowski/sentimentator/video_processing_service/internal/models"
)

templ JobStatsComponent(stats map[string]int64) {
	<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-5">
		<!-- Total Jobs -->
		<div class="p-6 bg-white rounded-lg shadow">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-sm font-medium text-gray-600">Total Jobs</p>
					<p class="text-3xl font-bold text-gray-900">{ fmt.Sprintf("%d", stats["total"]) }</p>
				</div>
				<div class="p-3 bg-blue-100 rounded-full">
					<svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
					</svg>
				</div>
			</div>
		</div>
		<!-- Pending Jobs -->
		<div class="p-6 bg-white rounded-lg shadow">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-sm font-medium text-gray-600">Pending</p>
					<p class="text-3xl font-bold text-yellow-600">{ fmt.Sprintf("%d", stats["pending"]) }</p>
				</div>
				<div class="p-3 bg-yellow-100 rounded-full">
					<svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
				</div>
			</div>
		</div>
		<!-- Processing Jobs -->
		<div class="p-6 bg-white rounded-lg shadow">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-sm font-medium text-gray-600">Processing</p>
					<p class="text-3xl font-bold text-blue-600">{ fmt.Sprintf("%d", stats["processing"]) }</p>
				</div>
				<div class="p-3 bg-blue-100 rounded-full">
					<svg class="w-6 h-6 text-blue-600 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
				</div>
			</div>
		</div>
		<!-- Completed Jobs -->
		<div class="p-6 bg-white rounded-lg shadow">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-sm font-medium text-gray-600">Completed</p>
					<p class="text-3xl font-bold text-green-600">{ fmt.Sprintf("%d", stats["completed"]) }</p>
				</div>
				<div class="p-3 bg-green-100 rounded-full">
					<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
				</div>
			</div>
		</div>
		<!-- Failed Jobs -->
		<div class="p-6 bg-white rounded-lg shadow">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-sm font-medium text-gray-600">Failed</p>
					<p class="text-3xl font-bold text-red-600">{ fmt.Sprintf("%d", stats["failed"]) }</p>
				</div>
				<div class="p-3 bg-red-100 rounded-full">
					<svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
				</div>
			</div>
		</div>
	</div>
}

templ JobStatsError(message string) {
	<div class="p-4 text-red-700 bg-red-100 rounded-lg">
		<p class="font-semibold">Error</p>
		<p class="text-sm">{ message }</p>
	</div>
}

templ VideoListComponent(videos []models.Video, total int) {
	<div class="overflow-hidden bg-white rounded-lg shadow">
		<div class="px-6 py-4 border-b border-gray-200">
			<div class="flex items-center justify-between">
				<h3 class="text-lg font-semibold text-gray-900">Videos ({ fmt.Sprintf("%d", total) })</h3>
				<button
					hx-get="/web/videos/list"
					hx-target="#video-list-container"
					hx-swap="innerHTML"
					class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700"
				>
					Refresh
				</button>
			</div>
		</div>
		<div class="divide-y divide-gray-200">
			if len(videos) == 0 {
				<div class="px-6 py-12 text-center">
					<svg class="w-12 h-12 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
					</svg>
					<p class="mt-2 text-sm text-gray-500">No videos found</p>
				</div>
			} else {
				for _, video := range videos {
					@VideoListItem(video)
				}
			}
		</div>
	</div>
}

templ VideoListItem(video models.Video) {
	<div class="px-6 py-4 hover:bg-gray-50">
		<div class="flex items-start justify-between">
			<div class="flex-1">
				<div class="flex items-center space-x-3">
					<h4 class="text-sm font-medium text-gray-900">
						if video.Title != "" {
							{ video.Title }
						} else {
							{ video.VideoID }
						}
					</h4>
				</div>
				<div class="mt-1 space-y-1">
					<p class="text-sm text-gray-500">
						<span class="font-medium">Platform:</span> { video.Platform }
						<span class="mx-2">•</span>
						<span class="font-medium">Video ID:</span> { video.VideoID }
					</p>
					if video.Duration > 0 {
						<p class="text-sm text-gray-500">
							<span class="font-medium">Duration:</span> { formatDuration(video.Duration) }
						</p>
					}
					<p class="text-sm text-gray-500">
						<span class="font-medium">Created:</span> { video.CreatedAt.Format("2006-01-02 15:04:05") }
					</p>
				</div>
				<!-- Transcripts -->
				if len(video.Transcripts) > 0 {
					<div class="mt-3">
						<p class="text-xs font-semibold text-gray-700">Transcripts:</p>
						<div class="mt-2 space-y-2">
							for _, transcript := range video.Transcripts {
								@TranscriptItem(transcript)
							}
						</div>
					</div>
				} else {
					<p class="mt-3 text-xs text-gray-400">No transcripts available</p>
				}
			</div>
		</div>
	</div>
}

templ TranscriptItem(transcript models.Transcript) {
	<div class="p-3 border border-gray-200 rounded-lg bg-gray-50">
		<div class="flex items-center justify-between">
			<div class="flex items-center space-x-2">
				<span class="text-xs font-medium text-gray-700">
					{ string(transcript.Method) } - { transcript.Language }
				</span>
				<span class={ "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium", getTranscriptStatusClass(string(transcript.Status)) }>
					{ string(transcript.Status) }
				</span>
			</div>
			<span class="text-xs text-gray-500">
				{ transcript.CreatedAt.Format("2006-01-02 15:04") }
			</span>
		</div>
		if transcript.Status == models.StatusCompleted && transcript.Text != "" {
			<div class="mt-2">
				<details class="text-xs text-gray-600">
					<summary class="text-sm text-blue-600 cursor-pointer">Show transcript</summary>
					<div class="mt-2 whitespace-pre-wrap">{ transcript.Text }</div>
				</details>
			</div>
		}
		if transcript.Error != "" {
			<div class="mt-2">
				<p class="text-xs text-red-600">
					Error: { transcript.Error }
				</p>
			</div>
		}
	</div>
}

templ VideoListError(message string) {
	<div class="p-4 text-red-700 bg-red-100 rounded-lg">
		<p class="font-semibold">Error</p>
		<p class="text-sm">{ message }</p>
	</div>
}

func getTranscriptStatusClass(status string) string {
	switch status {
	case "completed":
		return "bg-green-100 text-green-800"
	case "processing":
		return "bg-blue-100 text-blue-800"
	case "failed":
		return "bg-red-100 text-red-800"
	case "pending":
		return "bg-yellow-100 text-yellow-800"
	default:
		return "bg-gray-100 text-gray-800"
	}
}

func formatDuration(seconds int) string {

	hours := seconds / 3600
	minutes := (seconds % 3600) / 60
	secs := seconds % 60

	if hours > 0 {
		return fmt.Sprintf("%dh %dm %ds", hours, minutes, secs)
	} else if minutes > 0 {
		return fmt.Sprintf("%dm %ds", minutes, secs)
	}
	return fmt.Sprintf("%ds", secs)
}
