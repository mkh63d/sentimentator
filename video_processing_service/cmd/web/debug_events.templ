package web

templ DebugEventsPage() {
	@Base() {
		<div class="min-h-full">
			<header class="bg-white shadow-sm">
				<div class="px-4 py-6 mx-auto max-w-7xl sm:px-6 lg:px-8">
					<div class="flex items-center justify-between">
						<div>
							<h1 class="text-3xl font-bold tracking-tight text-gray-900">RabbitMQ Event Emulator</h1>
							<p class="mt-2 text-sm text-gray-600">Manually trigger events to test message processing</p>
						</div>
						<a href="/web/" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
							</svg>
							Back to Main
						</a>
					</div>
				</div>
			</header>
			<!-- Main Content -->
			<main class="py-10">
				<div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
					<!-- Events Grid -->
					<div class="grid gap-6 md:grid-cols-2">
						<!-- Video Received Event -->
						<div class="overflow-hidden bg-white shadow-lg rounded-xl ring-1 ring-black ring-opacity-5">
							<div class="px-6 py-5 border-b border-gray-200 bg-gradient-to-r from-blue-50 to-indigo-50">
								<div class="flex items-center">
									<div class="flex items-center justify-center w-10 h-10 bg-blue-500 rounded-lg">
										<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
										</svg>
									</div>
									<div class="ml-4">
										<h3 class="text-lg font-semibold text-gray-900">Video Received</h3>
										<p class="text-sm text-gray-600">video.received</p>
									</div>
								</div>
							</div>
							<div class="px-6 py-6">
								<form hx-post="/web/debug/events/video-received" hx-target="#result-video-received" hx-indicator="#spinner-video-received" class="space-y-4">
									<div>
										<label class="block text-sm font-medium text-gray-700">Video ID</label>
										<input type="text" name="video_id" placeholder="video-123" class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" required/>
									</div>
									<div>
										<label class="block text-sm font-medium text-gray-700">URL</label>
										<input type="text" name="url" placeholder="https://youtube.com/watch?v=abc" class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" required/>
									</div>
									<div>
										<label class="block text-sm font-medium text-gray-700">Platform</label>
										<select name="platform" class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
											<option value="youtube">YouTube</option>
											<option value="instagram">Instagram</option>
										</select>
									</div>
									<div>
										<label class="block text-sm font-medium text-gray-700">User ID (optional)</label>
										<input type="text" name="user_id" placeholder="user-456" class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"/>
									</div>
									<button type="submit" class="inline-flex items-center justify-center w-full px-4 py-2 text-white transition-colors bg-blue-500 rounded-lg hover:bg-blue-600">
										<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
										</svg>
										Publish Event
									</button>
									<div id="spinner-video-received" class="htmx-indicator">
										<svg class="w-6 h-6 mx-auto text-blue-500 animate-spin" fill="none" viewBox="0 0 24 24">
											<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
											<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
										</svg>
									</div>
								</form>
								<div id="result-video-received" class="mt-4"></div>
							</div>
						</div>
						<!-- Transcript Ready Event -->
						<div class="overflow-hidden bg-white shadow-lg rounded-xl ring-1 ring-black ring-opacity-5">
							<div class="px-6 py-5 border-b border-gray-200 bg-gradient-to-r from-green-50 to-emerald-50">
								<div class="flex items-center">
									<div class="flex items-center justify-center w-10 h-10 bg-green-500 rounded-lg">
										<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
										</svg>
									</div>
									<div class="ml-4">
										<h3 class="text-lg font-semibold text-gray-900">Transcript Ready</h3>
										<p class="text-sm text-gray-600">transcript.ready</p>
									</div>
								</div>
							</div>
							<div class="px-6 py-6">
								<form hx-post="/web/debug/events/transcript-ready" hx-target="#result-transcript-ready" hx-indicator="#spinner-transcript-ready" class="space-y-4">
									<div>
										<label class="block text-sm font-medium text-gray-700">Video ID</label>
										<input type="text" name="video_id" placeholder="video-123" class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent" required/>
									</div>
									<div>
										<label class="block text-sm font-medium text-gray-700">Transcript ID</label>
										<input type="text" name="transcript_id" placeholder="transcript-456" class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent" required/>
									</div>
									<div>
										<label class="block text-sm font-medium text-gray-700">Text</label>
										<textarea name="text" rows="3" placeholder="Transcript content..." class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent" required></textarea>
									</div>
									<div class="grid grid-cols-2 gap-4">
										<div>
											<label class="block text-sm font-medium text-gray-700">Language</label>
											<input type="text" name="language" value="en" class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"/>
										</div>
										<div>
											<label class="block text-sm font-medium text-gray-700">Duration (s)</label>
											<input type="number" name="duration" step="0.1" value="120.5" class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"/>
										</div>
									</div>
									<button type="submit" class="inline-flex items-center justify-center w-full px-4 py-2 text-white transition-colors bg-green-500 rounded-lg hover:bg-green-600">
										<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
										</svg>
										Publish Event
									</button>
									<div id="spinner-transcript-ready" class="htmx-indicator">
										<svg class="w-6 h-6 mx-auto text-green-500 animate-spin" fill="none" viewBox="0 0 24 24">
											<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
											<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
										</svg>
									</div>
								</form>
								<div id="result-transcript-ready" class="mt-4"></div>
							</div>
						</div>
						<!-- Processing Failed Event -->
						<div class="overflow-hidden bg-white shadow-lg rounded-xl ring-1 ring-black ring-opacity-5">
							<div class="px-6 py-5 border-b border-gray-200 bg-gradient-to-r from-red-50 to-orange-50">
								<div class="flex items-center">
									<div class="flex items-center justify-center w-10 h-10 bg-red-500 rounded-lg">
										<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
										</svg>
									</div>
									<div class="ml-4">
										<h3 class="text-lg font-semibold text-gray-900">Processing Failed</h3>
										<p class="text-sm text-gray-600">processing.failed</p>
									</div>
								</div>
							</div>
							<div class="px-6 py-6">
								<form hx-post="/web/debug/events/processing-failed" hx-target="#result-processing-failed" hx-indicator="#spinner-processing-failed" class="space-y-4">
									<div>
										<label class="block text-sm font-medium text-gray-700">Video ID</label>
										<input type="text" name="video_id" placeholder="video-123" class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" required/>
									</div>
									<div>
										<label class="block text-sm font-medium text-gray-700">Stage</label>
										<select name="stage" class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent">
											<option value="download">Download</option>
											<option value="transcription">Transcription</option>
											<option value="analysis">Analysis</option>
										</select>
									</div>
									<div>
										<label class="block text-sm font-medium text-gray-700">Error Message</label>
										<textarea name="error" rows="2" placeholder="Error details..." class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" required></textarea>
									</div>
									<div>
										<label class="block text-sm font-medium text-gray-700">Attempts</label>
										<input type="number" name="attempts" value="1" min="1" class="block w-full px-3 py-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"/>
									</div>
									<button type="submit" class="inline-flex items-center justify-center w-full px-4 py-2 text-white transition-colors bg-red-500 rounded-lg hover:bg-red-600">
										<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
										</svg>
										Publish Event
									</button>
									<div id="spinner-processing-failed" class="htmx-indicator">
										<svg class="w-6 h-6 mx-auto text-red-500 animate-spin" fill="none" viewBox="0 0 24 24">
											<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
											<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
										</svg>
									</div>
								</form>
								<div id="result-processing-failed" class="mt-4"></div>
							</div>
						</div>
					</div>
				</div>
			</main>
		</div>
	}
}

templ EventPublishedSuccess(eventType string) {
	<div class="p-4 border border-green-200 rounded-lg bg-green-50">
		<div class="flex items-center">
			<svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
			</svg>
			<span class="ml-2 text-sm font-medium text-green-800">
				Event <span class="font-mono">{ eventType }</span> published successfully!
			</span>
		</div>
	</div>
}

templ EventPublishedError(eventType string, errorMsg string) {
	<div class="p-4 border border-red-200 rounded-lg bg-red-50">
		<div class="flex items-start">
			<svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
			</svg>
			<div class="ml-2">
				<p class="text-sm font-medium text-red-800">
					Failed to publish <span class="font-mono">{ eventType }</span>
				</p>
				<p class="mt-1 text-xs text-red-700">{ errorMsg }</p>
			</div>
		</div>
	</div>
}
