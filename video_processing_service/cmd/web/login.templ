package web

templ LoginPage() {
	@Base() {
		<div class="flex items-center justify-center min-h-full px-4 py-12 sm:px-6 lg:px-8 bg-gray-50">
			<div class="w-full max-w-md space-y-8">
				<div class="text-center">
					<h2 class="mt-6 text-3xl font-bold tracking-tight text-gray-900">Access Debug Panel</h2>
					<p class="mt-2 text-sm text-gray-600">Enter the admin token to continue</p>
				</div>
				<form class="mt-8 space-y-6" method="post" action="/web/login">
					<div class="-space-y-px rounded-md shadow-sm">
						<div>
							<label for="token" class="sr-only">Admin Token</label>
							<input id="token" name="token" type="password" required class="relative block w-full px-3 py-2 placeholder-gray-400 border border-gray-300 rounded-md appearance-none focus:z-10 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 sm:text-sm" placeholder="Admin token"/>
						</div>
					</div>
					<div>
						<button type="submit" class="relative flex justify-center w-full px-4 py-2 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-md group hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
							Sign in
						</button>
					</div>
				</form>
				<div class="text-center">
					<a href="/web/" class="text-sm text-indigo-600 hover:text-indigo-500">Go to dashboard</a>
				</div>
			</div>
		</div>
	}
}
