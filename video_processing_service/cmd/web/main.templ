package web

templ MainPage() {
	@Base() {
		<div class="min-h-full">
			<header class="bg-white shadow-sm">
				<div class="px-4 py-6 mx-auto max-w-7xl sm:px-6 lg:px-8">
					<div class="flex items-center justify-between">
						<div>
							<h1 class="text-3xl font-bold tracking-tight text-gray-900">Sentimentator Debug Interface</h1>
							<p class="mt-2 text-sm text-gray-600">Video Processing Service - Development Tools</p>
						</div>
						<div class="flex items-center space-x-2">
							<span class="inline-flex items-center px-3 py-1 text-xs font-medium text-green-700 bg-green-100 rounded-full">
								<span class="w-2 h-2 mr-1.5 bg-green-600 rounded-full"></span>
								Service Active
							</span>
						</div>
					</div>
				</div>
			</header>
			<!-- Main Content -->
			<main class="py-10">
				<div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
					<!-- Debug Options Grid -->
					<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
						<!-- YouTube URL Submission Card -->
						<div class="overflow-hidden bg-white shadow-lg rounded-xl ring-1 ring-black ring-opacity-5 md:col-span-2 lg:col-span-3">
							<div class="px-6 py-5 border-b border-gray-200 bg-gradient-to-r from-orange-50 to-red-50">
								<div class="flex items-center">
									<div class="flex items-center justify-center w-12 h-12 bg-orange-500 rounded-lg">
										<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
										</svg>
									</div>
									<div class="ml-4">
										<h3 class="text-lg font-semibold text-gray-900">YouTube Video Processor</h3>
										<p class="text-sm text-gray-600">Submit a YouTube video URL for analysis</p>
									</div>
								</div>
							</div>
							<div class="px-6 py-6">
								<form hx-post="/web/video/process" method="POST" hx-target="#video-url-container" hx-indicator="#submit-spinner" class="space-y-4">
									<div>
										<label for="yt_url_input" class="block text-sm font-medium text-gray-700">
											YouTube Video URL
										</label>
										<div class="mt-2">
											<input
												type="text"
												id="yt_url_input"
												name="yt_url_input"
												placeholder="https://www.youtube.com/watch?v=..."
												class="block w-full px-4 py-3 placeholder-gray-400 transition-all duration-200 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-orange-500 focus:border-transparent"
												required
											/>
										</div>
										<p class="mt-2 text-sm text-gray-500">
											Enter a valid YouTube video URL to start processing
										</p>
									</div>
									<div class="flex items-center justify-between pt-4">
										<button
											type="submit"
											class="inline-flex items-center px-6 py-3 text-base font-medium text-white transition-all duration-200 transform bg-orange-500 border border-transparent rounded-lg shadow-sm cursor-pointer hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500 hover:scale-105 active:scale-95"
										>
											<svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
											</svg>
											Process Video
										</button>
										<div id="submit-spinner" class="htmx-indicator">
											<svg class="w-6 h-6 text-orange-500 animate-spin" fill="none" viewBox="0 0 24 24">
												<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
												<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
											</svg>
										</div>
									</div>
								</form>
								<div id="video-url-container" class="mt-6"></div>
							</div>
						</div>
						<!-- Placeholder Cards for Future Features -->
						<div class="overflow-hidden bg-white shadow-lg rounded-xl ring-1 ring-black ring-opacity-5 opacity-60 md:col-span-2 lg:col-span-3">
							<div class="px-6 py-5 border-b border-gray-200 bg-gradient-to-r from-blue-50 to-indigo-50">
								<div class="flex items-center">
									<div class="flex items-center justify-center w-12 h-12 bg-blue-500 rounded-lg">
										<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
										</svg>
									</div>
									<div class="ml-4">
										<h3 class="text-lg font-semibold text-gray-900">Processing Status</h3>
										<p class="text-sm text-gray-600">Monitor video processing jobs</p>
									</div>
								</div>
							</div>
							<div class="px-6 py-6">
								<p class="text-sm text-gray-500">Coming soon...</p>
							</div>
						</div>
					</div>
				</div>
			</main>
		</div>
	}
}

templ VideoUrlPost(yt_video_id string) {
	<div class="p-6 border-l-4 border-green-500 rounded-lg shadow-md bg-green-50">
		<div class="flex items-start">
			<div class="flex-shrink-0">
				<svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			</div>
			<div class="ml-3">
				<h3 class="text-sm font-medium text-green-800">Success!</h3>
				<div class="mt-2 text-sm text-green-700">
					<p>Video with YouTube ID: <span class="font-mono font-semibold">{ yt_video_id }</span> was successfully saved to the database for processing.</p>
				</div>
				<div class="mt-4">
					<div class="flex space-x-4 text-sm">
						<span class="text-green-600">
							<svg class="inline w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							Queued for processing
						</span>
					</div>
				</div>
			</div>
		</div>
	</div>
}
