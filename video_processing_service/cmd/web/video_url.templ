package web

import "fmt"

templ VideoUrlPost(videoID string, platform string, originalURL string, dbID int) {
	<div class="p-6 border-l-4 border-green-500 rounded-lg shadow-md bg-green-50">
		<div class="flex items-start">
			<div class="flex-shrink-0">
				<svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			</div>
			<div class="flex-1 ml-3">
				<h3 class="text-sm font-medium text-green-800">Video Successfully Queued!</h3>
				<div class="mt-3 text-sm text-green-700">
					<div class="space-y-2">
						<div class="flex items-start">
							<span class="font-semibold min-w-[100px]">Platform:</span>
							<span class="font-mono capitalize">{ platform }</span>
						</div>
						<div class="flex items-start">
							<span class="font-semibold min-w-[100px]">Video ID:</span>
							<span class="font-mono">{ videoID }</span>
						</div>
						<div class="flex items-start">
							<span class="font-semibold min-w-[100px]">Database ID:</span>
							<span class="font-mono">{ fmt.Sprintf("%d", dbID) }</span>
						</div>
						<div class="flex items-start">
							<span class="font-semibold min-w-[100px]">Original URL:</span>
							<span class="text-xs break-all">{ originalURL }</span>
						</div>
					</div>
				</div>
				<div class="pt-4 mt-4 border-t border-green-200">
					<div class="flex items-center space-x-4 text-sm">
						<span class="inline-flex items-center text-green-600">
							<svg class="inline w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							Status: Pending
						</span>
						<span class="inline-flex items-center text-green-600">
							<svg class="inline w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
							</svg>
							Queued for processing
						</span>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ VideoUrlError(errorMessage string) {
	<div class="p-6 border-l-4 border-red-500 rounded-lg shadow-md bg-red-50">
		<div class="flex items-start">
			<div class="flex-shrink-0">
				<svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			</div>
			<div class="ml-3">
				<h3 class="text-sm font-medium text-red-800">Error Processing Video URL</h3>
				<div class="mt-2 text-sm text-red-700">
					<p>{ errorMessage }</p>
				</div>
				<div class="mt-4">
					<p class="text-xs text-red-600">
						Please check the URL format and try again. Supported platforms: YouTube, Vimeo
					</p>
				</div>
			</div>
		</div>
	</div>
}
